{
  "name": "bloodbridge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BloodBridge - District Blood Donor Matching Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend",
    "build:all": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:validate": "npm run prisma:validate --workspace=backend",
    "check-types": "npm run check-types --workspace=backend && npm run check-types --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2"
  }
}
